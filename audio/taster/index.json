 "items": [
  {
   "id": "s1",
   "kind": "sentence",
   "text": "C'était une de ces jolies jeunes femmes qui semblent être nées, par une erreur du destin, dans une famille modeste.",
   "files": {
    "gemini-3.8-flash-tts": "audio/taster/gemini-3.8-flash-tts/s1.mp3",
