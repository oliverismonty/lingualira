 nine o'clock, as usual.'"]],[[[["Et"]," ",["ce"]," ",["n'"],["était"]," ",["pas"]," ",["tout"],"."],"And that wasn't all."],[[["Pour"]," ",["le"]," ",["bal"],", ",["on"]," ",["avait"]," ",["besoin"]," ",["de"]," ",["toutes"]," ",["les"]," ",["pièces"]," ",["de"]," ",["l'"],["appartement"],", ",["même"]," ",["de"]," ",["la"]," ",["chambre"]," ",["d'"],["Antoinette"],"."],"For the ball, they needed every room in the apartment, even Antoinette's bedroom."],[["« ",["Tu"]," ",["dormiras"]," ",["dans"]," ",["le"]," ",["petit"]," ",["débarras"],", ",["au"]," ",["fond"]," ",["du"]," ",["couloir"],", ",["a"]," ",["dit"]," ",["sa"]," ",["mère"],". ",["Et"]," ",["je"]," ",["ne"]," ",["veux"]," ",["pas"]," ",["t'"],["entendre"],". »"],"'You will sleep in the little storeroom at the end of the corridor,' said her mother. 'And I don't want to hear a sound from you.'"],[[["Antoinette"]," ",["n'"],["a"]," ",["pas"]," ",["pleuré"]," ",["devant"]," ",["sa"]," ",["mère"],"."],"Antoinette didn't cry in front of her mother."],[[["Elle"]," ",["est"]," ",["allée"]," ",["dans"]," ",["sa"]," ",["chambre"],", ",["elle"]," ",["a"]," ",["fermé"]," ",["la"]," ",["porte"],", ",["et"]," ",["elle"]," ",["a"]," ",["murmuré"]," ",["avec"]," ",["rage"]," : « ",["Je"]," ",["la"]," ",["déteste"],". ",["Un"]," ",["jour"],", ",["elle"]," ",["va"]," ",["payer"],". »"],"She went to her room, she closed the door, and she whispered furiously: 'I hate her. One day, she's going to pay.'"]]]},{"fr":"Les invitations","en":"The invitations","p":[[[[["Pendant"]," ",["plusieurs"]," ",["jours"],", ",["Antoinette"]," ",["a"]," ",["aidé"]," ",["sa"]," ",["mère"]," ",["à"]," ",["écrire"]," ",["les"]," ",["adresses"]," ",["sur"]," ",["les"]," ",["enveloppes"],"."],"For several days, Antoinette helped her mother write the addresses on the envelopes."],[[["Elle"]," ",["avait"]," ",["une"]," ",["belle"]," ",["écriture"],", ",["et"]," ",["Mme"]," ",["Kampf"]," ",["avait"]," ",["besoin"]," ",["d'"],["elle"],"."],"She had be